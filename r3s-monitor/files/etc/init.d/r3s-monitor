#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
    local lan_ip
    lan_ip="$(ubus call network.interface.lan status 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address')"
    [ -n "$lan_ip" ] || lan_ip="$(uci -q get network.lan.ipaddr)"
    [ -n "$lan_ip" ] || return 1

    mkdir -p /tmp/r3s-monitor /www/monitor
    ln -sfn /tmp/r3s-monitor/data.json /www/monitor/data.json

    procd_open_instance collector
    procd_set_param command /bin/sh /usr/bin/monitor-collector.sh
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    procd_open_instance web
    procd_set_param command /usr/sbin/uhttpd -f \
        -p "$lan_ip:54188" \
        -h /www/monitor \
        -t 10 -T 10 -k 10 -A 1 -n 10 -N 32
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
